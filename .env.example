# Salin file ini ke .env lalu isi nilainya. Aplikasi menolak jalan jika
# ADMIN_PASSWORD atau COOKIE_SECRET masih nilai contoh.
PORT=8080
DATA_DIR=./data
ADMIN_PASSWORD=ganti-saya
COOKIE_SECRET=ganti-saya-cookie-secret
EVENT_TITLE="Wall of Gratitude"
# URL publik, dipakai untuk isi QR. Di lokal: http://localhost:8080
PUBLIC_URL=http://localhost:8080
# Pagar rate limit per IP per jam (satu Wi-Fi venue). Bawaan 2000.
IP_PER_JAM=2000
